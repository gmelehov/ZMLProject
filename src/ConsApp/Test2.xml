<?xml version="1.0" encoding="utf-8" ?>
<App xmlns="ZMLAppSchema" name="ZML" globalVar="GLOBAL" target="F:\ZMLProject\src\ConsApp\Test2.xml.js">
  
  

  <Sources>
    <Source id="NamePartSrc" name="NamePartSrc" provider="local" key="id" autoload="true" pageSize="50">
      <Field id="id" type="string" key="true" />
      <Field id="name" type="string" />
    </Source>
    <Source id="GenderSrc" name="GenderSrc" provider="local" key="id" autoload="true" pageSize="50" descr="Локальные данные для комбобокса GenderCombo">
      <Item id="m" name="Муж." />
      <Item id="f" name="Жен." />
    </Source>
  </Sources>


  <Actions>
    <Action id="SomeAction1" run="rest" baseUrl="https://localhost:44320/ZmlProcessor/ProcessRawXml" method="POST" descr="Компиляция XML-разметки">
      <Prm id="TestEditor1" scope="Editor" />
      <set.prop targetId="TestEditor2" targetType="Editor" targetProp="value" />
      
    </Action>
  </Actions>
  

  <ViewPort target="mainContainer" layout="hbox">
    <Form id="TestForm" flex="1" bodyPadding="10">
      <Combo id="NamePartCombo" value="id" display="name" src="NamePartSrc" name="Часть имени" allowBlank="true">
        <Template id="BaseComboList" itemSelector="combo-item" field_a="name"/>
      </Combo>
      <Combo id="GenderCombo" value="id" display="name" src="GenderSrc" name="Пол" allowBlank="true">
        <Template id="BaseComboList" itemSelector="combo-item" field_a="name"/>
      </Combo>
      <MonthCombo id="MCombo" value="Id" display="Name" descr="ShortName">
        <Template id="BaseComboList" itemSelector="combo-item" field_a="Name"/>
      </MonthCombo>
    </Form>
    <Panel layout="vbox" flex="3">
      <Grid id="Grid1" src="NamePartSrc" sel="single" flex="1" title="ЗАГОЛОВОК ТАБЛИЦЫ" />
      <Editor id="TestEditor1" mode="xml" theme="Diff1" />
      <Editor id="TestEditor2" mode="javascript" theme="js" />
    </Panel>
  </ViewPort>

</App>



