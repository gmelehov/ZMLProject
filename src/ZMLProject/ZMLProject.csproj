<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiffCode.JSGenerator" Version="1.0.0" />
    <PackageReference Include="Handlebars.Net" Version="2.4.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Using Include="ZMLProject.Interfaces" />
    <Using Include="ZMLProject.Models" />
    <Using Include="ZMLProject.Models.Commands" />
    <Using Include="ZMLProject.Models.Data" />
    <Using Include="ZMLProject.Attrs" />
    <Using Include="ZMLProject.Utils" Static="true" />
  </ItemGroup>

</Project>
